<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= student.first_name %> <%= student.last_name %> — Grade Tracker</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="container nav-content">
            <a href="/" class="logo">📊 Grade Tracker</a>
            <ul class="nav-links">
                <li><a href="/">Dashboard</a></li>
                <li><a href="/students" class="active">Students</a></li>
            </ul>
        </div>
    </nav>

    <main class="container">
        <div class="page-header">
            <div>
                <h1 class="page-title"><%= student.first_name %> <%= student.last_name %></h1>
                <p class="text-muted"><%= student.email %></p>
            </div>
            <div class="header-actions">
                <a href="/students/<%= student.id %>/grades/new" class="btn btn-primary">+ Add Grade</a>
                <form action="/students/<%= student.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this student and all their grades?')">
                    <button type="submit" class="btn btn-danger">Delete Student</button>
                </form>
            </div>
        </div>

        <div class="stats-grid stats-small">
            <div class="stat-card">
                <div class="stat-value"><%= average %>%</div>
                <div class="stat-label">Overall Average</div>
            </div>
            <div class="stat-card">
                <div class="stat-value"><%= grades.length %></div>
                <div class="stat-label">Total Grades</div>
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">Grade History</h2>
            <% if (grades.length > 0) { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Score</th>
                            <th>Grade</th>
                            <th>Semester</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% grades.forEach(g => { %>
                        <tr>
                            <td><%= g.subject %></td>
                            <td><%= g.score %>%</td>
                            <td>
                                <span class="badge badge-<%= g.grade_letter === 'A' || g.grade_letter === 'B' ? 'success' : g.grade_letter === 'C' ? 'warning' : 'danger' %>">
                                    <%= g.grade_letter %>
                                </span>
                            </td>
                            <td><%= g.semester %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p class="empty-state">No grades recorded yet. Click "Add Grade" to get started.</p>
            <% } %>
        </div>
    </main>
</body>
</html>
